# ─────────────────────────────────────────────────────────────
# Fan Pulse — Environment Variables
# Copy this file to `.env` and fill in real values. NEVER commit
# the real `.env` (it is gitignored).
# ─────────────────────────────────────────────────────────────

# Admin dashboard password. REQUIRED in production.
# In production (NODE_ENV=production) admin access is DENIED if this is unset.
# Generate a strong one, e.g.:  openssl rand -base64 32
ADMIN_PASSWORD=

# SQLite database connection string (Prisma).
# Default for local dev:
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# ── Z.ai SDK (REQUIRED for Curation Studio, page_reader, web_search) ──
# The z-ai-web-dev-sdk reads its config from a .z-ai-config JSON file.
# On the Z.ai sandbox, /etc/.z-ai-config exists automatically.
# On Render/production, instrumentation.ts creates the file from this env var.
# Get your API key at https://z.ai/ (or use the sandbox default).
ZAI_API_KEY=
# Optional: override the Z.ai API base URL (default: https://internal-api.z.ai/v1)
# ZAI_BASE_URL=https://internal-api.z.ai/v1

# ── Optional: Cron-triggered refresh (for /api/cron/* endpoints) ──
# Set this to a random string and pass it via the X-Cron-Secret header
# when calling /api/cron/fpl-refresh from external cron services.
# CRON_SECRET=

# ── Optional: NextAuth (only if you enable the auth feature) ──
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3000
