# ─────────────────────────────────────────────────────────────────────────────
# Fan Pulse — .dockerignore
# Keeps the Docker build context small by excluding junk the build doesn't need.
# NOTE: We do NOT exclude *.png or *.md globally — those files exist in public/
# (og-image.png, apple-touch-icon.png) and are needed by the build script.
# ─────────────────────────────────────────────────────────────────────────────

# Version control + git metadata
.git
.gitignore
.gitattributes

# Dependencies — regenerated in the deps stage
node_modules
.pnp
.pnp.*

# Build output — regenerated in the builder stage
.next
out
build

# Environment files — Render injects env vars, no .env needed in image
.env
.env.local
.env.production
.env.*.local
.env.development

# Logs
*.log
dev.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Agent workspace artifacts (not part of the app)
agent-ctx
download
upload
.zscripts
pasted_image_*

# Large reference data files (NOT imported by src/ — verified via grep)
cbs_wc2026.json
early-qf-eng-nor.json
workspace-*.tar
*.tar
*.zip
*.gz

# Top-level screenshots from design reviews (NOT used by the app)
/admin-*.png
/emoji-cards-*.png
/curate-*.png
/dark-mode.png
/bottom.png
/arena-intel-fixed.png
/crisis-real-data.png
/elite-real-data.png
*.pdf

# Render / Fly / CI configs (not needed inside the image)
render.yaml
fly.toml
Caddyfile
