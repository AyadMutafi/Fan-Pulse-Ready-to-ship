# Version control
.git
.gitignore

# Dependencies
node_modules

# Build output (rebuilt in Docker)
.next
out
dist

# Database (kept on a Fly volume, never bake into image)
db/*.db
db/*.db-journal
db/*.db-wal
db/*.db-shm

# Logs
*.log
dev.log
server.log

# Env files (secrets set via `fly secrets set`)
.env
.env.local
.env.*.local

# IDE / OS
.vscode
.idea
.DS_Store
Thumbs.db

# Docker
Dockerfile
.dockerignore
fly.toml
# NOTE: docker-entrypoint.sh is intentionally NOT excluded here.
# The Dockerfile COPYs it into the runner stage. Excluding it (as the
# previous version did) makes the Docker build abort with
# "COPY failed: file not found in build context" — which was the
# root cause of every deploy failure in the prior sessions.

# Docs / screenshots
*.md
upload/
verify-*.png
