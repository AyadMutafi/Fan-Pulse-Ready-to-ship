generator client {
  provider        = "prisma-client-js"
  // Generate Prisma engines for the local dev host (native) AND the
  // production host (Debian-based Linux with OpenSSL 3.x).
  // The Z.ai platform and Fly.io both use Debian-based images, so we only
  // need the debian engine. The musl engine was removed to reduce the
  // standalone build size by ~17MB.
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── World Cup Models ──────────────────────────────────────────────────────────

model WCStage {
  id          String   @id @default(cuid())
  name        String   // "Group Stage", "Round of 32", "Round of 16", "Quarter Finals", "Semi Finals", "Final"
  nameAr      String   // Arabic name
  order       Int      // 1, 2, 3, 4, 5, 6
  status      String   @default("upcoming") // "upcoming" | "live" | "completed"
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  selections  WCSelection[]
}

model WCSelection {
  id         String   @id @default(cuid())
  type       String   // "elite" | "crisis"
  stageId    String
  stage      WCStage  @relation(fields: [stageId], references: [id], onDelete: Cascade)
  formation  String   @default("4-3-3")
  locked     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  players    WCSelectionPlayer[]
}

model WCSelectionPlayer {
  id           String   @id @default(cuid())
  selectionId  String
  selection    WCSelection @relation(fields: [selectionId], references: [id], onDelete: Cascade)
  playerName   String
  nationCode   String   // ISO country code e.g. "BRA", "KSA"
  position     String   // GK, CB, LB, RB, CM, CAM, LW, RW, ST
  pulseScore         Float    @default(0) // 0-100
  previousPulseScore Float    @default(0) // prior buzz score, for movement arrows
  lastBuzzRefreshAt  DateTime? // last live web_search refresh (R32 ticker)
  sentiment          Float    @default(0) // fan sentiment %
  trend              String   @default("stable") // "rising" | "stable" | "falling"
  isLive             Boolean  @default(false)
  matchInfo          String?  // e.g. "BRA vs ARG 2-1"
  order              Int      @default(0) // position in formation
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  pulseBreakdown PulseBreakdown?
}

model NationalTeam {
  id            String   @id @default(cuid())
  name          String   // "Brazil"
  nameAr        String   // "البرازيل"
  code          String   @unique // "BRA"
  flag          String   // emoji flag "🇧🇷"
  group         String   // "A", "B", etc.
  fifaRank      Int      @default(0)
  primaryColor  String   @default("#000000") // hex
  region        String   @default("") // "South America", "Europe", etc.
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Match {
  id             String   @id @default(cuid())
  homeTeamCode   String   // "ARG"
  homeTeamName   String   // "Argentina"
  homeTeamFlag   String   // "🇦🇷"
  awayTeamCode   String   // "FRA"
  awayTeamName   String   // "France"
  awayTeamFlag   String   // "🇫🇷"
  homeScore      Int      @default(0)
  awayScore      Int      @default(0)
  status         String   @default("completed") // "upcoming" | "live" | "completed"
  league         String   @default("WC") // "WC" | "Friendly"
  group         String   @default("") // "A", "B", etc. or "R16", "QF", "SF", "Final"
  minute         Int?     // match minute if live
  matchDate      DateTime?
  homeSentiment  Float    @default(50) // 0-100
  awaySentiment  Float    @default(50) // 0-100
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Hot path: the homepage + World Cup tab constantly query live/upcoming
  // matches ordered by date. `@@index([status, matchDate])` serves the
  // `WHERE status IN ('live','upcoming') ORDER BY matchDate` query.
  // `@@index([league, status, matchDate])` serves EPL matchday queries
  // (`WHERE league = 'EPL' AND status = 'live' ORDER BY matchDate`) — note
  // there is no separate LeagueMatch model; EPL matches live here with
  // `league = 'EPL'`. This index is what makes 7-concurrent-EPL-match loads
  // fast on Saturday.
  @@index([status, matchDate])
  @@index([league, status, matchDate])
}

// ── League Models (EPL + future leagues) ─────────────────────────────────────
// Pre-seeded league + team directory. Powers match-level voting (FanVote.matchId)
// and the future EPL matchday surface. Teams carry a stable `code` (e.g. "ARS")
// that joins onto Match.homeTeamCode / awayTeamCode when `league = 'EPL'`.

model League {
  id        String   @id @default(cuid())
  name      String   // "Premier League"
  slug      String   @unique // "epl"
  country   String   // "England"
  createdAt DateTime @default(now())
  teams     LeagueTeam[]
}

model LeagueTeam {
  id        String   @id @default(cuid())
  name      String   // "Arsenal"
  code      String   @unique // "ARS" — joins onto Match.homeTeamCode/awayTeamCode
  crestUrl  String?
  leagueId  String
  league    League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([leagueId])
}

// ── Pulse Score Engine Models ────────────────────────────────────────────────

/// Per-player breakdown of the 4 weighted Pulse Score components.
/// 1:1 with WCSelectionPlayer. Computed by computeAllPulseScores() in pulse-engine.
model PulseBreakdown {
  id                   String   @id @default(cuid())
  playerId             String   @unique
  player               WCSelectionPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  matchPerformance     Float    @default(50) // 0-100, weight 40%
  fanSentiment         Float    @default(50) // 0-100, weight 25%
  aiNarrative          Float    @default(50) // 0-100, weight 20%
  momentumTrend        Float    @default(50) // 0-100, weight 15%
  matchPerformanceNote String   @default("")
  fanSentimentNote     String   @default("")
  aiNarrativeNote      String   @default("")
  momentumTrendNote    String   @default("")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// ── Social Sentiment Models (fed by /api/social-sentiment) ───────────────────

/// A single scraped social post (Reddit/Twitter/web) about a team.
model SocialPost {
  id          String   @id @default(cuid())
  platform    String   // "reddit" | "twitter" | "web"
  postId      String
  author      String   @default("")
  content     String   @default("")
  language    String   @default("en")
  sentiment   Float    @default(50) // 0-100, LLM-scored
  likes       Int      @default(0)
  replies     Int      @default(0)
  shares      Int      @default(0)
  teamTag     String   @default("")
  searchQuery String   @default("")
  postedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([platform, postId])
}

/// Aggregated fan sentiment per team/language/platform/period.
/// Feeds the Pulse Score fanSentiment component and the FAN MOOD UI.
model SentimentSummary {
  id            String   @id @default(cuid())
  teamCode      String
  language      String
  avgSentiment  Float    @default(50) // 0-100
  postCount     Int      @default(0)
  positiveRatio Float    @default(0.5) // 0-1
  topTopics     String   @default("[]") // JSON-stringified array
  platform      String   @default("all") // "all" | "reddit" | "twitter" | "web"
  period        String   @default("24h")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([teamCode, language, platform, period])
}

// ── Fan Voting Models ────────────────────────────────────────────────────────

/// A fan's vote on a team's mood (0-100). One vote per session per team.
/// Extended for EPL match-level voting: `matchId` links a vote to a specific
/// Match (when `league = 'EPL'`), `intensity` captures how strongly the fan
/// feels (1-10), and `context` tags the in-match moment (GOAL, VAR, RED_CARD).
/// The original team-level voting path (teamCode + score, no matchId) is
/// untouched — `matchId` is optional and defaults to NULL.
model FanVote {
  id        String   @id @default(cuid())
  teamCode  String
  score     Int      // 0-100
  sessionId String
  /// Optional link to a Match for match-level voting (EPL matchday). NULL for
  /// the original team-level votes. NOT a foreign key — Match rows may be
  /// pruned over time, and we want votes to survive as a historical record.
  matchId   String?
  /// Optional 1-10 scale for how strongly the user feels. NULL = unspecified.
  intensity Int?
  /// Optional event context tag. Defaults to "GENERAL" so untagged votes still
  /// carry a human-readable label in aggregations.
  context   String   @default("GENERAL") // "GENERAL" | "GOAL" | "VAR" | "RED_CARD"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamCode, sessionId])
  // One vote per session per match (when matchId is set). SQLite treats NULL
  // matchId values as distinct, so team-level votes (matchId = NULL) are NOT
  // affected by this constraint — they remain bounded only by @@unique above.
  @@unique([matchId, sessionId])
  // Hot path: /api/fan-vote GET aggregates all votes per team, and the admin
  // dashboard filters by recency. This compound index supports both the
  // `WHERE teamCode = ? ORDER BY createdAt` and the team-scoped COUNT/SUM
  // aggregations without a full table scan — important when 7 concurrent EPL
  // matches generate 70+ votes/min.
  @@index([teamCode, createdAt])
  // Hot path: match-level aggregation queries votes for a single match ordered
  // by recency (`WHERE matchId = ? ORDER BY createdAt`). Separate from the
  // teamCode index because matchId and teamCode are independent filter paths.
  @@index([matchId, createdAt])
}

/// Aggregated fan ratings per player (1-10 scale). For the Rate tab.
model FanRating {
  id           String   @id @default(cuid())
  playerId     String
  playerName   String
  nationCode   String
  position     String
  avgRating    Float    @default(0) // 1-10
  totalRatings Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// A single user's rating submission for a player.
model UserRating {
  id        String   @id @default(cuid())
  sessionId String
  playerId  String
  rating    Int      // 1-10
  comment   String?
  createdAt DateTime @default(now())

  @@unique([sessionId, playerId])
}

// ── Admin-Seeded Fan Sentiment Pipeline ───────────────────────────────────────
// Implements the hybrid Layer 1+2+3 approach:
//   Layer 1: SDK scraping (web_search + page_reader + LLM scoring)
//   Layer 2: Reddit API integration (free, on-demand)
//   Layer 3: Admin-seeded monitoring (admin pastes hashtags + seed tweet URLs,
//            cron job re-searches every 5 min during the match window)
//
// Flow:
//   1. Admin creates FeedMonitor with hashtags + seed URLs + match window
//   2. Cron job runs every 5 min for active monitors → web_search + page_reader
//   3. LLM scores each post's sentiment (0-100) + extracts mentioned players
//   4. PlayerSentiment aggregate is recomputed (weighted avg of FeedPost scores)
//   5. Pulse Engine reads PlayerSentiment for the 25% Fan Sentiment component
//      (replaces the old "95% baseline" placeholder)

/// An admin-curated sentiment monitoring session for a specific match.
/// One FeedMonitor per match. Active while the match is being played + a
/// configurable cooldown window after.
model FeedMonitor {
  id              String   @id @default(cuid())
  matchLabel      String   // human-readable, e.g. "ESP vs KSA — Matchday 2"
  stageId         String?  // optional link to WCStage (Group Stage, R32, etc.)
  /// The Match.id this monitor was created for. When set, the fan-talk API
  /// filters monitors by EXACT matchId — not just team-code overlap. This
  /// prevents posts from one match bleeding into another match that shares
  /// a team code (e.g. ESP vs ARG posts showing on the ESP vs FRA card).
  matchId         String?  // optional link to Match (exact per-match scoping)
  teamCodes       String   @default("[]") // JSON array of team codes, e.g. ["ESP","KSA"]
  playerIds       String   @default("[]") // JSON array of WCSelectionPlayer IDs to track
  hashtags        String   @default("[]") // JSON array of hashtags, e.g. ["#ESP","#LamineYamal"]
  seedUrls        String   @default("[]") // JSON array of seed tweet/post URLs (anchor context)
  status          String   @default("active") // "active" | "paused" | "ended"
  refreshInterval Int      @default(5) // minutes between auto-refreshes
  lastRefreshedAt DateTime?
  endsAt          DateTime // auto-end time (typically kickoff + 6h)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  posts           FeedPost[]

  @@index([status, endsAt])
}

/// A single scraped post analyzed by the sentiment pipeline.
/// One FeedPost per (monitorId, url) — de-duplicated across refreshes.
model FeedPost {
  id                String   @id @default(cuid())
  monitorId         String
  monitor           FeedMonitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  platform          String   // "twitter" | "reddit" | "web"
  url               String   @unique
  author            String   @default("")
  content           String   @default("") // extracted text (truncated to ~2000 chars)
  language          String   @default("en")
  sentimentScore    Float    @default(50) // 0-100, LLM-scored
  positiveRatio     Float    @default(0.5) // 0-1
  mentionedPlayers  String   @default("[]") // JSON array of player IDs found in content
  topQuote          String?  // notable fan quote extracted by LLM (for UI display)
  postedAt          DateTime @default(now())
  analyzedAt        DateTime @default(now())

  @@index([monitorId, analyzedAt])
  @@index([mentionedPlayers])
}

/// Aggregated per-player sentiment derived from FeedPosts.
/// One PlayerSentiment per (playerId, monitorId) — the latest monitor wins.
/// Read by the Pulse Engine to compute the 25% Fan Sentiment component.
model PlayerSentiment {
  id              String   @id @default(cuid())
  playerId        String   @unique // 1:1 with WCSelectionPlayer
  monitorId       String?  // link to the FeedMonitor that produced this sentiment
  sentiment       Float    @default(50) // 0-100, weighted avg of FeedPost.sentimentScore
  postCount       Int      @default(0) // total posts mentioning this player
  positiveRatio   Float    @default(0.5) // 0-1
  topQuotes       String   @default("[]") // JSON array of {quote, source} objects
  avgEngagement   Float    @default(0) // avg likes+replies+shares (best-effort, often 0)
  analyzedAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([monitorId])
}

// ── Transfer Pulse Models ────────────────────────────────────────────────────
// Pre-season retention bridge between the WC 2026 final (Jul 19) and EPL
// kickoff (mid-August). Tracks fan SENTIMENT around transfer rumors.
//
// ANTI-HALLUCINATION CONTRACT (enforced in src/lib/transfer-pulse/):
//   - A rumor only enters the system if a Tier 1 journalist reported it
//     (verified against TIER1_HANDLES in tier1-sources.ts).
//   - Every card is labeled "RUMOR" in the UI.
//   - "fanReadLikelihood" is a FAN READ of how likely fans think it is —
//     NOT a prediction of whether the transfer will actually happen.
//   - Debunked sagas are ARCHIVED (status="debunked"), never deleted, so the
//     audit trail of what was reported and by whom is always preserved.
//   - Every TransferPost carries a real source URL with a real hostname
//     (x.com, reddit.com, etc.) — no fabricated content.

/// A single transfer rumor (a "saga"). One per (playerName, toClubCode).
model TransferSaga {
  id                  String   @id @default(cuid())
  playerName          String   // e.g. "Mohamed Salah"
  playerNationCode    String   @default("") // ISO code e.g. "EGY" (display only)
  fromClubCode        String   @default("") // e.g. "LIV"
  fromClubName        String   @default("") // e.g. "Liverpool"
  toClubCode          String   // e.g. "SAU" (Al-Hilal)
  toClubName          String   // e.g. "Al-Hilal"
  status              String   @default("active") // "active" | "completed" | "debunked"
  feeReported         String   @default("") // e.g. "£150m" (display string, may be empty)
  tier1Count          Int      @default(0) // number of distinct Tier 1 journalists reporting
  fanReadLikelihood   Float    @default(50) // 0-100, FAN READ not prediction
  buzzVolume          Int      @default(0) // total fan posts analyzed
  buzzTrend           String   @default("stable") // "rising" | "stable" | "falling"
  excitedPct          Float    @default(0) // 0-100
  skepticalPct        Float    @default(0) // 0-100
  dreadingPct         Float    @default(0) // 0-100
  avgSentiment        Float    @default(50) // 0-100
  firstReportedAt     DateTime @default(now())
  lastUpdatedAt       DateTime @default(now())
  resolvedAt          DateTime?
  /// When a saga is resolved (completed/debunked), this is the official
  /// confirmation URL — typically a Tier 1 journalist's "Here We Go" tweet.
  /// NULL for active sagas. Surfaced in the detail modal so users can click
  /// through to the source that resolved the rumor.
  resolutionUrl       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  sources             TransferSource[]
  posts               TransferPost[]
  timeline            SentimentTimeline[]

  @@unique([playerName, toClubCode])
  @@index([status, buzzVolume])
  @@index([status, lastUpdatedAt])
}

/// A Tier 1 journalist report that anchors a saga. A saga only exists because
/// at least one of these was verified. URL is unique — same article never
/// counted twice.
model TransferSource {
  id              String   @id @default(cuid())
  sagaId          String
  saga            TransferSaga @relation(fields: [sagaId], references: [id], onDelete: Cascade)
  journalistName  String   // e.g. "Fabrizio Romano"
  journalistHandle String  // e.g. "FabrizioRomano" (without @)
  tier            Int      @default(1) // 1 = Tier 1 (always 1 in v1)
  url             String   @unique // the real article/post URL
  headline        String   @default("") // short headline / summary
  outlet          String   @default("") // e.g. "The Athletic", "Sky Sports"
  reportedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([sagaId])
}

/// A single fan post about a saga, scored for sentiment. URL is unique —
/// same post never ingested twice across refreshes.
model TransferPost {
  id              String   @id @default(cuid())
  sagaId          String
  saga            TransferSaga @relation(fields: [sagaId], references: [id], onDelete: Cascade)
  platform        String   // "twitter" | "reddit" | "web" | "instagram" | "youtube" | "facebook" | "tiktok"
  author          String   @default("") // handle without @, or username
  content         String   @default("") // verbatim or near-verbatim text
  url             String   @unique // real source URL
  sentimentScore  Float    @default(50) // 0-100
  sentimentLabel  String   @default("neutral") // "excited" | "skeptical" | "dreading" | "neutral"
  postedAt        DateTime @default(now())
  analyzedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([sagaId, postedAt])
  @@index([sagaId, sentimentLabel])
}

/// Daily sentiment snapshot for the 7-day timeline chart. One per (saga, date).
model SentimentTimeline {
  id              String   @id @default(cuid())
  sagaId          String
  saga            TransferSaga @relation(fields: [sagaId], references: [id], onDelete: Cascade)
  date            String   // YYYY-MM-DD (SQLite-friendly; avoids TZ issues)
  excitedPct      Float    @default(0) // 0-100
  skepticalPct    Float    @default(0) // 0-100
  dreadingPct     Float    @default(0) // 0-100
  avgSentiment    Float    @default(50) // 0-100
  postCount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([sagaId, date])
  @@index([sagaId, date])
}
