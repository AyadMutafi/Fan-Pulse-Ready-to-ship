generator client {
  provider      = "prisma-client-js"
  // Generate Prisma engines for the local dev host (native) AND the
  // production host (Debian-based Linux with OpenSSL 3.x).
  // The Z.ai platform and Fly.io both use Debian-based images, so we only
  // need the debian engine. The musl engine was removed to reduce the
  // standalone build size by ~17MB.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── World Cup Models ──────────────────────────────────────────────────────────

model WCStage {
  id          String        @id @default(cuid())
  name        String // "Group Stage", "Round of 32", "Round of 16", "Quarter Finals", "Semi Finals", "Final"
  nameAr      String // Arabic name
  order       Int // 1, 2, 3, 4, 5, 6
  status      String        @default("upcoming") // "upcoming" | "live" | "completed"
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  selections  WCSelection[]
}

model WCSelection {
  id        String              @id @default(cuid())
  type      String // "elite" | "crisis"
  stageId   String
  stage     WCStage             @relation(fields: [stageId], references: [id], onDelete: Cascade)
  formation String              @default("4-3-3")
  locked    Boolean             @default(false)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  players   WCSelectionPlayer[]
}

model WCSelectionPlayer {
  id                 String          @id @default(cuid())
  selectionId        String
  selection          WCSelection     @relation(fields: [selectionId], references: [id], onDelete: Cascade)
  playerName         String
  nationCode         String // ISO country code e.g. "BRA", "KSA"
  position           String // GK, CB, LB, RB, CM, CAM, LW, RW, ST
  pulseScore         Float           @default(0) // 0-100
  previousPulseScore Float           @default(0) // prior buzz score, for movement arrows
  lastBuzzRefreshAt  DateTime? // last live web_search refresh (R32 ticker)
  sentiment          Float           @default(0) // fan sentiment %
  trend              String          @default("stable") // "rising" | "stable" | "falling"
  isLive             Boolean         @default(false)
  matchInfo          String? // e.g. "BRA vs ARG 2-1"
  order              Int             @default(0) // position in formation
  /// Wikipedia/CC-BY-SA thumbnail URL for the player. NULL when no Wikipedia
  /// photo exists (the UI renders a graceful initials-on-purple fallback).
  /// Always starts with https://upload.wikimedia.org/ when set — never a
  /// Google Image scrape or unlicensed source. See src/lib/wikipedia-photo.ts.
  photoUrl           String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  pulseBreakdown     PulseBreakdown?
}

model NationalTeam {
  id           String   @id @default(cuid())
  name         String // "Brazil"
  nameAr       String // "البرازيل"
  code         String   @unique // "BRA"
  flag         String // emoji flag "🇧🇷"
  group        String // "A", "B", etc.
  fifaRank     Int      @default(0)
  primaryColor String   @default("#000000") // hex
  region       String   @default("") // "South America", "Europe", etc.
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Match {
  id            String    @id @default(cuid())
  homeTeamCode  String // "ARG"
  homeTeamName  String // "Argentina"
  homeTeamFlag  String // "🇦🇷"
  awayTeamCode  String // "FRA"
  awayTeamName  String // "France"
  awayTeamFlag  String // "🇫🇷"
  homeScore     Int       @default(0)
  awayScore     Int       @default(0)
  status        String    @default("completed") // "upcoming" | "live" | "completed"
  league        String    @default("WC") // "WC" | "Friendly"
  group         String    @default("") // "A", "B", etc. or "R16", "QF", "SF", "Final"
  minute        Int? // match minute if live
  matchDate     DateTime?
  homeSentiment Float     @default(50) // 0-100
  awaySentiment Float     @default(50) // 0-100
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Hot path: the homepage + World Cup tab constantly query live/upcoming
  // matches ordered by date. `@@index([status, matchDate])` serves the
  // `WHERE status IN ('live','upcoming') ORDER BY matchDate` query.
  // `@@index([league, status, matchDate])` serves EPL matchday queries
  // (`WHERE league = 'EPL' AND status = 'live' ORDER BY matchDate`) — note
  // there is no separate LeagueMatch model; EPL matches live here with
  // `league = 'EPL'`. This index is what makes 7-concurrent-EPL-match loads
  // fast on Saturday.
  @@index([status, matchDate])
  @@index([league, status, matchDate])
}

// ── League Models (EPL + future leagues) ─────────────────────────────────────
// Pre-seeded league + team directory. Powers match-level voting (FanVote.matchId)
// and the future EPL matchday surface. Teams carry a stable `code` (e.g. "ARS")
// that joins onto Match.homeTeamCode / awayTeamCode when `league = 'EPL'`.

model League {
  id        String       @id @default(cuid())
  name      String // "Premier League"
  slug      String       @unique // "epl"
  country   String // "England"
  createdAt DateTime     @default(now())
  teams     LeagueTeam[]
}

model LeagueTeam {
  id        String   @id @default(cuid())
  name      String // "Arsenal"
  code      String   @unique // "ARS" — joins onto Match.homeTeamCode/awayTeamCode
  crestUrl  String?
  leagueId  String
  league    League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([leagueId])
}

// ── EPL League Player Models ─────────────────────────────────────────────────
// Powers the LEAGUE tab (Team of the Week) and the FPL tab (Captain Pulse +
// Differentials). Players are synced from the FPL bootstrap-static API by the
// /api/fpl/sync admin endpoint. Each LeaguePlayer is matched 1:1 to an FPLPlayer
// record (by name + team) so we can join FPL ownership/form data with fan
// sentiment from FanVote rows.
//
// ANTI-HALLUCINATION: LeaguePlayer rows are ONLY created by /api/fpl/sync from
// the REAL FPL API. Never hand-seeded, never invented. The TOTW generator only
// selects players that have real match performance data (from LeagueMatch rows
// with status='completed'). If no matches exist yet (pre-season), the TOTW tab
// shows an honest empty state — never a fabricated XI.

/// A player in the EPL (or future league). One per (name, teamCode, season).
/// Synced from FPL bootstrap-static by /api/fpl/sync.
model LeaguePlayer {
  id                 String   @id @default(cuid())
  name               String // "Bukayo Saka"
  webName            String   @default("") // "Saka" — FPL web_name
  teamCode           String // "ARS" — joins onto LeagueTeam.code + Match.homeTeamCode
  league             String   @default("EPL") // "EPL" | future leagues
  season             String   @default("2026-27") // "2026-27"
  position           String // "GK" | "DEF" | "MID" | "FWD" (FPL element_type)
  /// Fan Pulse Score (0-100). Computed by /api/epl/compute-pulse. Combines
  /// match performance + fan sentiment + form. 0 = not yet computed.
  pulseScore         Float    @default(0)
  previousPulseScore Float    @default(0)
  sentiment          Float    @default(50) // 0-100, from FanVote aggregation
  trend              String   @default("stable") // "rising" | "stable" | "falling"
  /// Wikipedia/CC-BY-SA thumbnail URL. NULL = initials fallback.
  photoUrl           String?
  /// FPL player ID for joining to FPLPlayer. NULL when not matched.
  fplId              Int?     @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([name, teamCode, season])
  @@index([league, season])
  @@index([teamCode])
  @@index([position])
}

/// A completed or upcoming EPL match. Populated from FPL fixtures by /api/fpl/sync.
/// Used by the TOTW generator to compute match performance per player.
/// NOTE: this is distinct from the generic Match model (which is WC-focused).
/// LeagueMatch carries EPL-specific fields (matchweek, FPL fixture ID).
model LeagueMatch {
  id           String   @id @default(cuid())
  league       String   @default("EPL")
  season       String   @default("2026-27")
  matchweek    Int // 1, 2, 3, ...
  homeTeamCode String // "ARS"
  awayTeamCode String // "CHE"
  homeScore    Int?
  awayScore    Int?
  status       String   @default("upcoming") // "upcoming" | "live" | "completed"
  kickoffAt    DateTime
  /// FPL fixture ID for joining to FPLFixture. NULL for non-FPL sources.
  fplFixtureId Int?     @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([league, season, matchweek, homeTeamCode, awayTeamCode])
  @@index([league, season, matchweek, status])
  @@index([status, kickoffAt])
}

/// Team of the Week (or Flops of the Week) for a given matchweek.
/// One per (league, season, matchweek, type). Published by /api/epl/totw/publish.
model TeamOfTheWeek {
  id          String   @id @default(cuid())
  league      String   @default("EPL")
  season      String   @default("2026-27")
  matchweek   Int
  type        String // "totw" | "flops"
  formation   String   @default("4-3-3")
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  players TOTWPlayer[]

  @@unique([league, season, matchweek, type])
  @@index([league, season, matchweek])
}

/// A player in a Team of the Week XI. 11 rows per TOTW (4-3-3 formation).
model TOTWPlayer {
  id         String        @id @default(cuid())
  totwId     String
  totw       TeamOfTheWeek @relation(fields: [totwId], references: [id], onDelete: Cascade)
  playerName String // "Bukayo Saka"
  teamCode   String // "ARS"
  position   String // "GK" | "RB" | "CB" | "LB" | "CM" | "CAM" | "RW" | "ST" | "LW"
  pulseScore Float         @default(0) // 0-100, snapshot at publish time
  sentiment  Float         @default(50) // 0-100, fan sentiment snapshot
  /// Why this player was selected — e.g. "2 goals vs CHE", "Clean sheet vs LIV"
  matchInfo  String        @default("")
  /// Wikipedia/CC-BY-SA thumbnail URL. NULL = initials fallback.
  photoUrl   String?
  order      Int           @default(0) // position in formation
  createdAt  DateTime      @default(now())

  @@index([totwId])
}

/// FPL player data synced from fantasy.premierleague.com/api/bootstrap-static/.
/// One per FPL element. Joined 1:1 to LeaguePlayer via fplId.
/// Powers the Captain Pulse + Differentials features.
model FPLPlayer {
  id            String   @id @default(cuid())
  fplId         Int      @unique // FPL element ID
  webName       String   @default("") // "Saka"
  fullName      String   @default("") // "Bukayo Saka" (first_name + second_name)
  teamCode      String // "ARS" — resolved from FPL team ID
  teamFplId     Int // 1-20 (FPL team ID)
  position      String // "GK" | "DEF" | "MID" | "FWD"
  price         Float    @default(0) // now_cost / 10 (e.g. 9.0)
  ownershipPct  Float    @default(0) // selected_by_percent
  form          Float    @default(0) // 0-10 scale
  totalPoints   Int      @default(0)
  pointsPerGame Float    @default(0)
  minutes       Int      @default(0)
  goals         Int      @default(0)
  assists       Int      @default(0)
  cleanSheets   Int      @default(0)
  /// Synced from FPL at the same time as the player data.
  syncedAt      DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([teamCode])
  @@index([position])
  @@index([ownershipPct])
}

/// FPL fixture synced from fantasy.premierleague.com/api/fixtures/.
/// Joined to LeagueMatch via fplFixtureId.
model FPLFixture {
  id            String   @id @default(cuid())
  fplId         Int      @unique // FPL fixture ID
  gameweek      Int // event number
  homeTeamFplId Int
  awayTeamFplId Int
  homeTeamCode  String // "ARS" — resolved from FPL team ID
  awayTeamCode  String // "CHE"
  kickoffTime   DateTime
  finished      Boolean  @default(false)
  started       Boolean  @default(false)
  homeScore     Int?
  awayScore     Int?
  minutes       Int      @default(0)
  syncedAt      DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([gameweek, finished])
  @@index([kickoffTime])
}

/// FPL gameweek synced from bootstrap-static events array.
model FPLGameweek {
  id           String   @id @default(cuid())
  fplId        Int      @unique // event ID
  name         String // "Gameweek 1"
  deadlineTime DateTime
  isCurrent    Boolean  @default(false)
  isNext       Boolean  @default(false)
  finished     Boolean  @default(false)
  averageScore Int      @default(0)
  // Nullable — FPL API returns null for unplayed gameweeks (highest_score
  // is only set after the gameweek finishes). Prisma's @default(0) on a
  // non-null field rejects null on upsert.create, so we mark it nullable.
  highestScore Int?
  syncedAt     DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isCurrent])
  @@index([isNext])
}

// ── Founder-Curated Link Pipeline (70% manual curation) ──────────────────────
// The founder manually pastes tweet/post URLs for a specific match. The AI
// then reads + scores ONLY those specific URLs (never invents content).
//
// ANTI-HALLUCINATION CONTRACT (enforced in src/app/api/curate/route.ts):
//   - Every CuratedLink.url MUST start with https:// and be from an allowed
//     domain (x.com, twitter.com, reddit.com, instagram.com, facebook.com,
//     tiktok.com, or a real news hostname). URLs failing this check are
//     rejected before any AI call.
//   - content is extracted by page_reader (src/lib/ai). If page_reader fails
//     or returns a block message, the URL is SKIPPED — never fabricated.
//   - postedAt is parsed from the page content; if unparseable, defaults to
//     now. Links older than 7 days are rejected (freshness guarantee for
//     live-match curation).
//   - sentimentScore (0-100) is LLM-scored from the REAL extracted content.
//   - Author is extracted from the URL (handle) or hostname — never invented.
//
// FAN TALK INTEGRATION (src/lib/live-fan-talk.ts):
//   When Fan Talk is requested for a match, CuratedLink rows for that match
//   are checked FIRST. If > 3 curated links exist, they are the primary
//   source (web_search is skipped — the "70% manual" path). If < 3, the
//   existing web_search pipeline runs ("30% AI backup") and curated links
//   are merged in. This is the 70/30 curation pattern.

/// A founder-curated social/news link for a specific match. One per URL.
model CuratedLink {
  id             String   @id @default(cuid())
  /// Optional link to a Match. NULL for "add new match" (manual entry) where
  /// the founder typed a matchLabel but no matchId exists yet. NOT a foreign
  /// key — Match rows may be pruned, curated links must survive as audit trail.
  matchId        String?
  /// Human label: "Arsenal vs Chelsea — Friendly Jul 28". Required so the
  /// link is always displayable even if the Match row is gone.
  matchLabel     String
  /// The real tweet/post URL. @unique → natural dedupe on re-curation.
  url            String   @unique
  /// "twitter" | "reddit" | "instagram" | "facebook" | "tiktok" | "web"
  platform       String
  /// @handle (twitter) or hostname (web) or r/subreddit (reddit). Extracted
  /// from the URL structure; never invented.
  author         String
  /// Extracted text from page_reader. May be truncated. NEVER fabricated.
  content        String
  /// 0-100, LLM-scored from the real content. 50 = neutral default.
  sentimentScore Float    @default(50)
  /// "excited" | "skeptical" | "dreading" | "neutral". Derived from score.
  sentimentLabel String   @default("neutral")
  /// JSON array of hashtags, e.g. ["#Arsenal","#COYG"]. From founder input.
  hashtags       String   @default("[]")
  /// When the original post was made. Parsed from page content or URL.
  /// If unparseable, defaults to the curation time (now).
  postedAt       DateTime
  /// When the founder added this link. Audit trail.
  curatedAt      DateTime @default(now())
  /// Who curated it. Defaults to "founder". Audit trail.
  curatedBy      String   @default("founder")
  /// Soft-delete / suppress flag. false = hidden from Fan Talk.
  isActive       Boolean  @default(true)

  @@index([matchId, postedAt])
  @@index([platform, postedAt])
}

// ── Ballon d'Or Source-Fed Pipeline (admin curation + AI scoring) ────────────
// Admin pastes a URL (stats page, journalist article, or social post) for a
// specific player. The AI reads the page via page_reader and extracts either
// statistics, article sentiment, or fan sentiment depending on sourceType.
// Computed componentScore per row feeds into the per-player aggregate in
// BallonDorContender.
//
// ANTI-HALLUCINATION CONTRACT:
//   - Every url MUST start with https:// and be from an allowlisted domain.
//   - content is extracted by page_reader. If page_reader fails, the URL is
//     SKIPPED — never fabricated.
//   - extractedData is LLM-extracted from the REAL page content only.

model BallonDorSource {
  id              String   @id @default(cuid())
  playerName      String // matches BallonDorContender.name (case-sensitive)
  sourceType      String // "stats" | "article" | "social"
  url             String   @unique
  platform        String   @default("web") // "twitter" | "reddit" | "web" | ...
  author          String   @default("")
  content         String   @default("") // extracted text, max 2000 chars
  postedAt        DateTime @default(now())
  extractedData   String   @default("{}") // JSON blob (shape depends on sourceType)
  componentScore  Float    @default(50) // 0-100
  componentLabel  String   @default("neutral")
  topQuote        String?
  analysisError   String?
  curatedAt       DateTime @default(now())
  curatedBy       String   @default("founder")
  isActive        Boolean  @default(true)

  contender       BallonDorContender? @relation(fields: [playerName], references: [name], onDelete: NoAction, onUpdate: NoAction)

  @@index([playerName, sourceType, postedAt])
  @@index([sourceType, postedAt])
  @@index([platform, postedAt])
}

/// One row per player. Seeded from VERIFIED_BALLON_DOR_CONTENDERS on first
/// deploy. ballonDorScore is a composite derived from BallonDorSource rows.
model BallonDorContender {
  id              String   @id @default(cuid())
  name            String   @unique
  nationCode      String
  position        String
  clubName        String
  clubCode        String
  ballonDorScore  Float    @default(50)
  previousScore   Float    @default(50)
  trend           String   @default("stable")
  reason          String   @default("")
  awardWon        String?
  verifiedMatchFact String @default("")
  photoUrl        String?
  // Component breakdown (denormalized at recompute time)
  statsScore      Float    @default(50)
  articleScore    Float    @default(50)
  socialScore     Float    @default(50)
  statsSourceCount    Int  @default(0)
  articleSourceCount  Int  @default(0)
  socialSourceCount   Int  @default(0)
  lastRecomputedAt DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  isActive        Boolean  @default(true)

  sources         BallonDorSource[]

  @@index([ballonDorScore])
  @@index([trend])
  @@index([nationCode])
}

// ── Pulse Score Engine Models ────────────────────────────────────────────────

/// Per-player breakdown of the 4 weighted Pulse Score components.
/// 1:1 with WCSelectionPlayer. Computed by computeAllPulseScores() in pulse-engine.
model PulseBreakdown {
  id                   String            @id @default(cuid())
  playerId             String            @unique
  player               WCSelectionPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  matchPerformance     Float             @default(50) // 0-100, weight 40%
  fanSentiment         Float             @default(50) // 0-100, weight 25%
  aiNarrative          Float             @default(50) // 0-100, weight 20%
  momentumTrend        Float             @default(50) // 0-100, weight 15%
  matchPerformanceNote String            @default("")
  fanSentimentNote     String            @default("")
  aiNarrativeNote      String            @default("")
  momentumTrendNote    String            @default("")
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
}

// ── Social Sentiment Models (fed by /api/social-sentiment) ───────────────────

/// A single scraped social post (Reddit/Twitter/web) about a team.
model SocialPost {
  id          String   @id @default(cuid())
  platform    String // "reddit" | "twitter" | "web"
  postId      String
  author      String   @default("")
  content     String   @default("")
  language    String   @default("en")
  sentiment   Float    @default(50) // 0-100, LLM-scored
  likes       Int      @default(0)
  replies     Int      @default(0)
  shares      Int      @default(0)
  teamTag     String   @default("")
  searchQuery String   @default("")
  postedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([platform, postId])
}

/// Aggregated fan sentiment per team/language/platform/period.
/// Feeds the Pulse Score fanSentiment component and the FAN MOOD UI.
model SentimentSummary {
  id            String   @id @default(cuid())
  teamCode      String
  language      String
  avgSentiment  Float    @default(50) // 0-100
  postCount     Int      @default(0)
  positiveRatio Float    @default(0.5) // 0-1
  topTopics     String   @default("[]") // JSON-stringified array
  platform      String   @default("all") // "all" | "reddit" | "twitter" | "web"
  period        String   @default("24h")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([teamCode, language, platform, period])
}

// ── Fan Voting Models ────────────────────────────────────────────────────────

/// A fan's vote on a team's mood (0-100). One vote per session per team.
/// Extended for EPL match-level voting: `matchId` links a vote to a specific
/// Match (when `league = 'EPL'`), `intensity` captures how strongly the fan
/// feels (1-10), and `context` tags the in-match moment (GOAL, VAR, RED_CARD).
/// The original team-level voting path (teamCode + score, no matchId) is
/// untouched — `matchId` is optional and defaults to NULL.
model FanVote {
  id        String   @id @default(cuid())
  teamCode  String
  score     Int // 0-100
  sessionId String
  /// Optional link to a Match for match-level voting (EPL matchday). NULL for
  /// the original team-level votes. NOT a foreign key — Match rows may be
  /// pruned over time, and we want votes to survive as a historical record.
  matchId   String?
  /// Optional 1-10 scale for how strongly the user feels. NULL = unspecified.
  intensity Int?
  /// Optional event context tag. Defaults to "GENERAL" so untagged votes still
  /// carry a human-readable label in aggregations.
  context   String   @default("GENERAL") // "GENERAL" | "GOAL" | "VAR" | "RED_CARD"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamCode, sessionId])
  // One vote per session per match (when matchId is set). SQLite treats NULL
  // matchId values as distinct, so team-level votes (matchId = NULL) are NOT
  // affected by this constraint — they remain bounded only by @@unique above.
  @@unique([matchId, sessionId])
  // Hot path: /api/fan-vote GET aggregates all votes per team, and the admin
  // dashboard filters by recency. This compound index supports both the
  // `WHERE teamCode = ? ORDER BY createdAt` and the team-scoped COUNT/SUM
  // aggregations without a full table scan — important when 7 concurrent EPL
  // matches generate 70+ votes/min.
  @@index([teamCode, createdAt])
  // Hot path: match-level aggregation queries votes for a single match ordered
  // by recency (`WHERE matchId = ? ORDER BY createdAt`). Separate from the
  // teamCode index because matchId and teamCode are independent filter paths.
  @@index([matchId, createdAt])
}

/// Aggregated fan ratings per player (1-10 scale). For the Rate tab.
model FanRating {
  id           String   @id @default(cuid())
  playerId     String
  playerName   String
  nationCode   String
  position     String
  avgRating    Float    @default(0) // 1-10
  totalRatings Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// A single user's rating submission for a player.
model UserRating {
  id        String   @id @default(cuid())
  sessionId String
  playerId  String
  rating    Int // 1-10
  comment   String?
  createdAt DateTime @default(now())

  @@unique([sessionId, playerId])
}

// ── Admin-Seeded Fan Sentiment Pipeline ───────────────────────────────────────
// Implements the hybrid Layer 1+2+3 approach:
//   Layer 1: SDK scraping (web_search + page_reader + LLM scoring)
//   Layer 2: Reddit API integration (free, on-demand)
//   Layer 3: Admin-seeded monitoring (admin pastes hashtags + seed tweet URLs,
//            cron job re-searches every 5 min during the match window)
//
// Flow:
//   1. Admin creates FeedMonitor with hashtags + seed URLs + match window
//   2. Cron job runs every 5 min for active monitors → web_search + page_reader
//   3. LLM scores each post's sentiment (0-100) + extracts mentioned players
//   4. PlayerSentiment aggregate is recomputed (weighted avg of FeedPost scores)
//   5. Pulse Engine reads PlayerSentiment for the 25% Fan Sentiment component
//      (replaces the old "95% baseline" placeholder)

/// An admin-curated sentiment monitoring session for a specific match.
/// One FeedMonitor per match. Active while the match is being played + a
/// configurable cooldown window after.
model FeedMonitor {
  id              String    @id @default(cuid())
  matchLabel      String // human-readable, e.g. "ESP vs KSA — Matchday 2"
  stageId         String? // optional link to WCStage (Group Stage, R32, etc.)
  /// The Match.id this monitor was created for. When set, the fan-talk API
  /// filters monitors by EXACT matchId — not just team-code overlap. This
  /// prevents posts from one match bleeding into another match that shares
  /// a team code (e.g. ESP vs ARG posts showing on the ESP vs FRA card).
  matchId         String? // optional link to Match (exact per-match scoping)
  teamCodes       String    @default("[]") // JSON array of team codes, e.g. ["ESP","KSA"]
  playerIds       String    @default("[]") // JSON array of WCSelectionPlayer IDs to track
  hashtags        String    @default("[]") // JSON array of hashtags, e.g. ["#ESP","#LamineYamal"]
  seedUrls        String    @default("[]") // JSON array of seed tweet/post URLs (anchor context)
  status          String    @default("active") // "active" | "paused" | "ended"
  refreshInterval Int       @default(5) // minutes between auto-refreshes
  lastRefreshedAt DateTime?
  endsAt          DateTime // auto-end time (typically kickoff + 6h)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  posts FeedPost[]

  @@index([status, endsAt])
}

/// A single scraped post analyzed by the sentiment pipeline.
/// One FeedPost per (monitorId, url) — de-duplicated across refreshes.
model FeedPost {
  id               String      @id @default(cuid())
  monitorId        String
  monitor          FeedMonitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  platform         String // "twitter" | "reddit" | "web"
  url              String      @unique
  author           String      @default("")
  content          String      @default("") // extracted text (truncated to ~2000 chars)
  language         String      @default("en")
  sentimentScore   Float       @default(50) // 0-100, LLM-scored
  positiveRatio    Float       @default(0.5) // 0-1
  mentionedPlayers String      @default("[]") // JSON array of player IDs found in content
  topQuote         String? // notable fan quote extracted by LLM (for UI display)
  postedAt         DateTime    @default(now())
  analyzedAt       DateTime    @default(now())

  @@index([monitorId, analyzedAt])
  @@index([mentionedPlayers])
}

/// Aggregated per-player sentiment derived from FeedPosts.
/// One PlayerSentiment per (playerId, monitorId) — the latest monitor wins.
/// Read by the Pulse Engine to compute the 25% Fan Sentiment component.
model PlayerSentiment {
  id            String   @id @default(cuid())
  playerId      String   @unique // 1:1 with WCSelectionPlayer
  monitorId     String? // link to the FeedMonitor that produced this sentiment
  sentiment     Float    @default(50) // 0-100, weighted avg of FeedPost.sentimentScore
  postCount     Int      @default(0) // total posts mentioning this player
  positiveRatio Float    @default(0.5) // 0-1
  topQuotes     String   @default("[]") // JSON array of {quote, source} objects
  avgEngagement Float    @default(0) // avg likes+replies+shares (best-effort, often 0)
  analyzedAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([monitorId])
}

// ── Transfer Pulse Models ────────────────────────────────────────────────────
// Pre-season retention bridge between the WC 2026 final (Jul 19) and EPL
// kickoff (mid-August). Tracks fan SENTIMENT around transfer rumors.
//
// ANTI-HALLUCINATION CONTRACT (enforced in src/lib/transfer-pulse/):
//   - A rumor only enters the system if a Tier 1 journalist reported it
//     (verified against TIER1_HANDLES in tier1-sources.ts).
//   - Every card is labeled "RUMOR" in the UI.
//   - "fanReadLikelihood" is a FAN READ of how likely fans think it is —
//     NOT a prediction of whether the transfer will actually happen.
//   - Debunked sagas are ARCHIVED (status="debunked"), never deleted, so the
//     audit trail of what was reported and by whom is always preserved.
//   - Every TransferPost carries a real source URL with a real hostname
//     (x.com, reddit.com, etc.) — no fabricated content.

/// A single transfer rumor (a "saga"). One per (playerName, toClubCode).
model TransferSaga {
  id                String    @id @default(cuid())
  playerName        String // e.g. "Mohamed Salah"
  playerNationCode  String    @default("") // ISO code e.g. "EGY" (display only)
  fromClubCode      String    @default("") // e.g. "LIV"
  fromClubName      String    @default("") // e.g. "Liverpool"
  toClubCode        String // e.g. "SAU" (Al-Hilal)
  toClubName        String // e.g. "Al-Hilal"
  status            String    @default("active") // "active" | "completed" | "debunked"
  feeReported       String    @default("") // e.g. "£150m" (display string, may be empty)
  tier1Count        Int       @default(0) // number of distinct Tier 1 journalists reporting
  fanReadLikelihood Float     @default(50) // 0-100, FAN READ not prediction
  buzzVolume        Int       @default(0) // total fan posts analyzed
  buzzTrend         String    @default("stable") // "rising" | "stable" | "falling"
  excitedPct        Float     @default(0) // 0-100
  skepticalPct      Float     @default(0) // 0-100
  dreadingPct       Float     @default(0) // 0-100
  avgSentiment      Float     @default(50) // 0-100
  firstReportedAt   DateTime  @default(now())
  lastUpdatedAt     DateTime  @default(now())
  resolvedAt        DateTime?
  /// When a saga is resolved (completed/debunked), this is the official
  /// confirmation URL — typically a Tier 1 journalist's "Here We Go" tweet.
  /// NULL for active sagas. Surfaced in the detail modal so users can click
  /// through to the source that resolved the rumor.
  resolutionUrl     String?
  /// Free-text explanation of why a saga was resolved (completed/debunked).
  /// NULL for active sagas. For debunked sagas, explains the contradiction
  /// (e.g. "Player signed new contract with current club — no Tier 1 source
  /// for the rumored transfer"). Surfaced in the detail modal so users see
  /// WHY the rumor was marked false.
  resolutionNotes   String?
  /// Wikipedia/CC-BY-SA thumbnail URL for the transfer TARGET player. NULL
  /// when no Wikipedia photo exists (UI shows initials fallback). Always
  /// https://upload.wikimedia.org/ when set. See src/lib/wikipedia-photo.ts.
  playerPhotoUrl    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sources  TransferSource[]
  posts    TransferPost[]
  timeline SentimentTimeline[]

  @@unique([playerName, toClubCode])
  @@index([status, buzzVolume])
  @@index([status, lastUpdatedAt])
}

/// A Tier 1 journalist report that anchors a saga. A saga only exists because
/// at least one of these was verified. URL is unique — same article never
/// counted twice.
model TransferSource {
  id               String       @id @default(cuid())
  sagaId           String
  saga             TransferSaga @relation(fields: [sagaId], references: [id], onDelete: Cascade)
  journalistName   String // e.g. "Fabrizio Romano"
  journalistHandle String // e.g. "FabrizioRomano" (without @)
  tier             Int          @default(1) // 1 = Tier 1 (always 1 in v1)
  url              String       @unique // the real article/post URL
  headline         String       @default("") // short headline / summary
  outlet           String       @default("") // e.g. "The Athletic", "Sky Sports"
  reportedAt       DateTime     @default(now())
  createdAt        DateTime     @default(now())

  @@index([sagaId])
}

/// A single fan post about a saga, scored for sentiment. URL is unique —
/// same post never ingested twice across refreshes.
model TransferPost {
  id             String       @id @default(cuid())
  sagaId         String
  saga           TransferSaga @relation(fields: [sagaId], references: [id], onDelete: Cascade)
  platform       String // "twitter" | "reddit" | "web" | "instagram" | "youtube" | "facebook" | "tiktok"
  author         String       @default("") // handle without @, or username
  content        String       @default("") // verbatim or near-verbatim text
  url            String       @unique // real source URL
  sentimentScore Float        @default(50) // 0-100
  sentimentLabel String       @default("neutral") // "excited" | "skeptical" | "dreading" | "neutral"
  postedAt       DateTime     @default(now())
  analyzedAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@index([sagaId, postedAt])
  @@index([sagaId, sentimentLabel])
}

/// Daily sentiment snapshot for the 7-day timeline chart. One per (saga, date).
model SentimentTimeline {
  id           String       @id @default(cuid())
  sagaId       String
  saga         TransferSaga @relation(fields: [sagaId], references: [id], onDelete: Cascade)
  date         String // YYYY-MM-DD (SQLite-friendly; avoids TZ issues)
  excitedPct   Float        @default(0) // 0-100
  skepticalPct Float        @default(0) // 0-100
  dreadingPct  Float        @default(0) // 0-100
  avgSentiment Float        @default(50) // 0-100
  postCount    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([sagaId, date])
  @@index([sagaId, date])
}
