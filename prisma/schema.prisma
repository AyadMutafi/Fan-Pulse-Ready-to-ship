generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── World Cup Models ──────────────────────────────────────────────────────────

model WCStage {
  id          String   @id @default(cuid())
  name        String   // "Group Stage", "Round of 32", "Round of 16", "Quarter Finals", "Semi Finals", "Final"
  nameAr      String   // Arabic name
  order       Int      // 1, 2, 3, 4, 5, 6
  status      String   @default("upcoming") // "upcoming" | "live" | "completed"
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  selections  WCSelection[]
}

model WCSelection {
  id         String   @id @default(cuid())
  type       String   // "elite" | "crisis"
  stageId    String
  stage      WCStage  @relation(fields: [stageId], references: [id], onDelete: Cascade)
  formation  String   @default("4-3-3")
  locked     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  players    WCSelectionPlayer[]
}

model WCSelectionPlayer {
  id           String   @id @default(cuid())
  selectionId  String
  selection    WCSelection @relation(fields: [selectionId], references: [id], onDelete: Cascade)
  playerName   String
  nationCode   String   // ISO country code e.g. "BRA", "KSA"
  position     String   // GK, CB, LB, RB, CM, CAM, LW, RW, ST
  pulseScore         Float    @default(0) // 0-100
  previousPulseScore Float    @default(0) // prior buzz score, for movement arrows
  lastBuzzRefreshAt  DateTime? // last live web_search refresh (R32 ticker)
  sentiment          Float    @default(0) // fan sentiment %
  trend              String   @default("stable") // "rising" | "stable" | "falling"
  isLive             Boolean  @default(false)
  matchInfo          String?  // e.g. "BRA vs ARG 2-1"
  order              Int      @default(0) // position in formation
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  pulseBreakdown PulseBreakdown?
}

model NationalTeam {
  id            String   @id @default(cuid())
  name          String   // "Brazil"
  nameAr        String   // "البرازيل"
  code          String   @unique // "BRA"
  flag          String   // emoji flag "🇧🇷"
  group         String   // "A", "B", etc.
  fifaRank      Int      @default(0)
  primaryColor  String   @default("#000000") // hex
  region        String   @default("") // "South America", "Europe", etc.
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Match {
  id             String   @id @default(cuid())
  homeTeamCode   String   // "ARG"
  homeTeamName   String   // "Argentina"
  homeTeamFlag   String   // "🇦🇷"
  awayTeamCode   String   // "FRA"
  awayTeamName   String   // "France"
  awayTeamFlag   String   // "🇫🇷"
  homeScore      Int      @default(0)
  awayScore      Int      @default(0)
  status         String   @default("completed") // "upcoming" | "live" | "completed"
  league         String   @default("WC") // "WC" | "Friendly"
  group         String   @default("") // "A", "B", etc. or "R16", "QF", "SF", "Final"
  minute         Int?     // match minute if live
  matchDate      DateTime?
  homeSentiment  Float    @default(50) // 0-100
  awaySentiment  Float    @default(50) // 0-100
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ── Pulse Score Engine Models ────────────────────────────────────────────────

/// Per-player breakdown of the 4 weighted Pulse Score components.
/// 1:1 with WCSelectionPlayer. Computed by computeAllPulseScores() in pulse-engine.
model PulseBreakdown {
  id                   String   @id @default(cuid())
  playerId             String   @unique
  player               WCSelectionPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  matchPerformance     Float    @default(50) // 0-100, weight 40%
  fanSentiment         Float    @default(50) // 0-100, weight 25%
  aiNarrative          Float    @default(50) // 0-100, weight 20%
  momentumTrend        Float    @default(50) // 0-100, weight 15%
  matchPerformanceNote String   @default("")
  fanSentimentNote     String   @default("")
  aiNarrativeNote      String   @default("")
  momentumTrendNote    String   @default("")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// ── Social Sentiment Models (fed by /api/social-sentiment) ───────────────────

/// A single scraped social post (Reddit/Twitter/web) about a team.
model SocialPost {
  id          String   @id @default(cuid())
  platform    String   // "reddit" | "twitter" | "web"
  postId      String
  author      String   @default("")
  content     String   @default("")
  language    String   @default("en")
  sentiment   Float    @default(50) // 0-100, LLM-scored
  likes       Int      @default(0)
  replies     Int      @default(0)
  shares      Int      @default(0)
  teamTag     String   @default("")
  searchQuery String   @default("")
  postedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([platform, postId])
}

/// Aggregated fan sentiment per team/language/platform/period.
/// Feeds the Pulse Score fanSentiment component and the FAN MOOD UI.
model SentimentSummary {
  id            String   @id @default(cuid())
  teamCode      String
  language      String
  avgSentiment  Float    @default(50) // 0-100
  postCount     Int      @default(0)
  positiveRatio Float    @default(0.5) // 0-1
  topTopics     String   @default("[]") // JSON-stringified array
  platform      String   @default("all") // "all" | "reddit" | "twitter" | "web"
  period        String   @default("24h")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([teamCode, language, platform, period])
}

// ── Fan Voting Models ────────────────────────────────────────────────────────

/// A fan's vote on a team's mood (0-100). One vote per session per team.
model FanVote {
  id        String   @id @default(cuid())
  teamCode  String
  score     Int      // 0-100
  sessionId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamCode, sessionId])
}

/// Aggregated fan ratings per player (1-10 scale). For the Rate tab.
model FanRating {
  id           String   @id @default(cuid())
  playerId     String
  playerName   String
  nationCode   String
  position     String
  avgRating    Float    @default(0) // 1-10
  totalRatings Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// A single user's rating submission for a player.
model UserRating {
  id        String   @id @default(cuid())
  sessionId String   @default("anonymous")
  playerId  String
  rating    Int      // 1-10
  comment   String?
  createdAt DateTime @default(now())
}

// ── Admin-Seeded Fan Sentiment Pipeline ───────────────────────────────────────
// Implements the hybrid Layer 1+2+3 approach:
//   Layer 1: SDK scraping (web_search + page_reader + LLM scoring)
//   Layer 2: Reddit API integration (free, on-demand)
//   Layer 3: Admin-seeded monitoring (admin pastes hashtags + seed tweet URLs,
//            cron job re-searches every 5 min during the match window)
//
// Flow:
//   1. Admin creates FeedMonitor with hashtags + seed URLs + match window
//   2. Cron job runs every 5 min for active monitors → web_search + page_reader
//   3. LLM scores each post's sentiment (0-100) + extracts mentioned players
//   4. PlayerSentiment aggregate is recomputed (weighted avg of FeedPost scores)
//   5. Pulse Engine reads PlayerSentiment for the 25% Fan Sentiment component
//      (replaces the old "95% baseline" placeholder)

/// An admin-curated sentiment monitoring session for a specific match.
/// One FeedMonitor per match. Active while the match is being played + a
/// configurable cooldown window after.
model FeedMonitor {
  id              String   @id @default(cuid())
  matchLabel      String   // human-readable, e.g. "ESP vs KSA — Matchday 2"
  stageId         String?  // optional link to WCStage (Group Stage, R32, etc.)
  teamCodes       String   @default("[]") // JSON array of team codes, e.g. ["ESP","KSA"]
  playerIds       String   @default("[]") // JSON array of WCSelectionPlayer IDs to track
  hashtags        String   @default("[]") // JSON array of hashtags, e.g. ["#ESP","#LamineYamal"]
  seedUrls        String   @default("[]") // JSON array of seed tweet/post URLs (anchor context)
  status          String   @default("active") // "active" | "paused" | "ended"
  refreshInterval Int      @default(5) // minutes between auto-refreshes
  lastRefreshedAt DateTime?
  endsAt          DateTime // auto-end time (typically kickoff + 6h)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  posts           FeedPost[]

  @@index([status, endsAt])
}

/// A single scraped post analyzed by the sentiment pipeline.
/// One FeedPost per (monitorId, url) — de-duplicated across refreshes.
model FeedPost {
  id                String   @id @default(cuid())
  monitorId         String
  monitor           FeedMonitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  platform          String   // "twitter" | "reddit" | "web"
  url               String   @unique
  author            String   @default("")
  content           String   @default("") // extracted text (truncated to ~2000 chars)
  language          String   @default("en")
  sentimentScore    Float    @default(50) // 0-100, LLM-scored
  positiveRatio     Float    @default(0.5) // 0-1
  mentionedPlayers  String   @default("[]") // JSON array of player IDs found in content
  topQuote          String?  // notable fan quote extracted by LLM (for UI display)
  postedAt          DateTime @default(now())
  analyzedAt        DateTime @default(now())

  @@index([monitorId, analyzedAt])
  @@index([mentionedPlayers])
}

/// Aggregated per-player sentiment derived from FeedPosts.
/// One PlayerSentiment per (playerId, monitorId) — the latest monitor wins.
/// Read by the Pulse Engine to compute the 25% Fan Sentiment component.
model PlayerSentiment {
  id              String   @id @default(cuid())
  playerId        String   @unique // 1:1 with WCSelectionPlayer
  monitorId       String?  // link to the FeedMonitor that produced this sentiment
  sentiment       Float    @default(50) // 0-100, weighted avg of FeedPost.sentimentScore
  postCount       Int      @default(0) // total posts mentioning this player
  positiveRatio   Float    @default(0.5) // 0-1
  topQuotes       String   @default("[]") // JSON array of {quote, source} objects
  avgEngagement   Float    @default(0) // avg likes+replies+shares (best-effort, often 0)
  analyzedAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([monitorId])
}
