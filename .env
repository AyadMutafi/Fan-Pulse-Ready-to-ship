DATABASE_URL=file:/home/z/my-project/db/custom.db

# Admin password for /api/admin/* and /api/transfers/resolve endpoints.
# Used by the resolve endpoint to mark sagas as completed/debunked.
# Local dev value — override in production via the deploy platform's env vars.
ADMIN_PASSWORD=fp_dev_admin_2026

# Shared secret for the /api/transfers/cron endpoint (allows the cron job to
# authenticate without the admin password). Optional — admin password also works.
CRON_SECRET=fp_cron_secret_2026
